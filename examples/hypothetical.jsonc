{
  "audio": {
    "sample_rate": 48000,
    "channel_count": 1,
    "stream_buffer_size": 256,
    "sample_count": 8192,
    "dft_bin_count": 2048,
    "bands_history_length": 1024,
  },
  "transforms": {
    "left half": {
      "top left": { "screen": [0.0, 0.0] },
      "scale": { "screen": [0.5, 1.0] },
      "rotation": 0.0,
    },
    "right half": {
      "top right": { "screen": [1.0, 0.0] },
      "scale": { "screen": [0.5, 1.0] },
      "rotation": 0.0,
    },
  },
  "materials": {
    "slim waveform": {
      "shader": "waveform",
      "parameters": {
        "col": [1.0, 1.0, 1.0],
        "line_width": 10.0,
        "gain": 1.0,
      },
    },
    "red spectrogram": {
      "shader": "spectrogram",
      "parameters": {
        "width": 0.5,
        "gain": 0.7,
      },
    },
  },
  "panels": [
    {
      "transform": "left half",
      "material": "slim waveform",
      "order": 0,
    },
    {
      "transform": "right half",
      "material": "red spectrogram",
      "order": 0,
    },
  ],
}
