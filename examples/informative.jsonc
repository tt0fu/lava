{
  "audio": {
    "sample_rate": 48000,
    "channel_count": 1,
    "stream_buffer_size": 256,
    "sample_count": 8192,
    "dft_bin_count": 2048,
    "bands_history_length": 1024,
    "bands_history_delta": 0.005,
  },
  "transforms": {
    "bottom strip": {
      "anchor": "bottom left",
      "position": [
        [0.0, "w"],
        [1.0, "h"],
      ],
      "scale": [
        [1.0, "w"],
        [0.2, "h"],
      ],
      "rotation": 0.0,
    },
    "middle strip": {
      "anchor": "bottom left",
      "position": [
        [0.0, "w"],
        [0.8, "h"],
      ],
      "scale": [
        [1.0, "w"],
        [0.4, "h"],
      ],
      "rotation": 0.0,
    },
    "top strip": {
      "anchor": "bottom left",
      "position": [
        [0.0, "w"],
        [0.4, "h"],
      ],
      "scale": [
        [1.0, "w"],
        [0.4, "h"],
      ],
      "rotation": 0.0,
    },
    "fullscreen": {
      "anchor": "top left",
      "position": [
        [0.0, "w"],
        [0.0, "h"],
      ],
      "scale": [
        [1.0, "w"],
        [1.0, "h"],
      ],
      "rotation": 0.0,
    },
  },
  "materials": {
    "waveform": {
      "shader": "waveform",
      "parameters": {
        "background": [0.0, 0.0, 0.0, 0.0],
        "foreground": [1.0, 1.0, 1.0, 1.0],
        "line_width": 50.0,
        "gain": 1.0,
      },
    },
    "spectrogram": {
      "shader": "spectrogram",
      "parameters": {
        "background": [0.0, 0.0, 0.0, 0.0],
        "foreground": [1.0, 1.0, 1.0, 1.0],
        "gain": 2.0,
        "debug": true,
      },
    },
    "bands": {
      "shader": "bands",
      "parameters": {
        "col": [1.0, 1.0, 1.0],
        "gain": [1.5, 2.0, 3.0, 8.0],
      },
    },
  },
  "panels": {
    "transform": "fullscreen",
    "order": 0,
    "blend": "normal",
    "background_color": [0.0, 0.0, 0.0, 1.0],
    "children": [
      {
        "transform": "bottom strip",
        "material": "bands",
        "order": 0,
        "blend": "normal",
      },
      {
        "transform": "middle strip",
        "material": "spectrogram",
        "order": 0,
        "blend": "normal",
      },
      {
        "transform": "top strip",
        "material": "waveform",
        "order": 0,
        "blend": "normal",
      },
    ],
  },
}
