{
  "audio": {
    "sample_rate": 48000,
    "channel_count": 1,
    "stream_buffer_size": 256,
    "sample_count": 8192,
    "dft_bin_count": 2048,
    "bands_history_length": 1024,
    "bands_history_delta": 0.005,
  },
  "transforms": {
    "top strip": {
      "anchor": "top",
      "position": [
        [0.5, "w"],
        [0.0, "h"],
      ],
      "scale": [
        [1.0, "w"],
        [0.3, "h"],
      ],
      "rotation": 0.0,
    },
    "bottom strip": {
      "anchor": "top",
      "position": [
        [0.5, "w"],
        [1.0, "h"],
      ],
      "scale": [
        [-1.0, "w"],
        [-0.3, "h"],
      ],
      "rotation": 0.0,
    },
    "center": {
      "anchor": "center",
      "position": [
        [0.5, "w"],
        [0.5, "h"],
      ],
      "scale": [
        [0.4, "h"],
        [0.4, "h"],
      ],
      "rotation": 0.0,
    },

    "left": {
      "anchor": "left",
      "position": [
        [0.0, "w"],
        [0.5, "h"],
      ],
      "scale": [
        [0.38, "w"],
        [0.4, "h"],
      ],
      "rotation": 0.0,
    },
    "left top": {
      "anchor": "bottom left",
      "position": [
        [0.0, "w"],
        [0.5, "h"],
      ],
      "scale": [
        [0.38, "w"],
        [0.2, "h"],
      ],
      "rotation": 0.0,
    },
    "left bottom": {
      "anchor": "bottom left",
      "position": [
        [0.0, "w"],
        [0.5, "h"],
      ],
      "scale": [
        [0.38, "w"],
        [-0.2, "h"],
      ],
      "rotation": 0.0,
    },

    "right": {
      "anchor": "right",
      "position": [
        [1.0, "w"],
        [0.5, "h"],
      ],
      "scale": [
        [0.38, "w"],
        [0.4, "h"],
      ],
      "rotation": 0.0,
    },
    "right top": {
      "anchor": "bottom left",
      "position": [
        [1.0, "w"],
        [0.5, "h"],
      ],
      "scale": [
        [-0.38, "w"],
        [0.2, "h"],
      ],
      "rotation": 0.0,
    },
    "right bottom": {
      "anchor": "bottom left",
      "position": [
        [1.0, "w"],
        [0.5, "h"],
      ],
      "scale": [
        [-0.38, "w"],
        [-0.2, "h"],
      ],
      "rotation": 0.0,
    },
  },
  "images": {
    "logo": "./logo.png",
  },
  "materials": {
    "waveform": {
      "shader": "waveform",
      "parameters": {
        "background": [0.0, 0.0, 0.0, 0.0],
        "foreground": [1.0, 1.0, 1.0, 1.0],
        "line_width": 50.0,
        "gain": 1.0,
      },
    },
    "spectrogram": {
      "shader": "spectrogram",
      "parameters": {
        "background": [0.0, 0.0, 0.0, 0.0],
        "foreground": [1.0, 1.0, 1.0, 1.0],
        "gain": 1.8,
        "debug": false,
      },
    },
    "pattern": {
      "shader": "pattern",
      "parameters": {
        "lightness": 0.8,
        "chroma": 0.1,
        "scale": 1.0,
        "repeats": 5.0,
        "warp_speed": 1.0,
        "scroll_speed": 1.0,
      },
    },
    "logo": {
      "shader": "image",
      "parameters": {
        "image": "logo",
        "multiply": [1.0, 1.0, 1.0, 1.0],
        "add": [0.0, 0.0, 0.0, 0.0],
        "band_weights": [1.0, 0.0, 0.0, 0.0],
        "min_size": 0.5,
      },
    },
  },
  "panels": [
    {
      "transform": "top strip",
      "material": "pattern",
      "order": 0,
      "blend": "normal",
    },
    {
      "transform": "top strip",
      "material": "waveform",
      "order": 1,
      "blend": "multiply",
    },

    {
      "transform": "bottom strip",
      "material": "pattern",
      "order": 0,
      "blend": "normal",
    },
    {
      "transform": "bottom strip",
      "material": "waveform",
      "order": 1,
      "blend": "multiply",
    },

    {
      "transform": "left",
      "material": "pattern",
      "order": 0,
      "blend": "normal",
    },
    {
      "transform": "left top",
      "material": "spectrogram",
      "order": 1,
      "blend": "multiply",
    },
    {
      "transform": "left bottom",
      "material": "spectrogram",
      "order": 1,
      "blend": "multiply",
    },

    {
      "transform": "right",
      "material": "pattern",
      "order": 0,
      "blend": "normal",
    },
    {
      "transform": "right top",
      "material": "spectrogram",
      "order": 1,
      "blend": "multiply",
    },
    {
      "transform": "right bottom",
      "material": "spectrogram",
      "order": 1,
      "blend": "multiply",
    },

    {
      "transform": "center",
      "material": "pattern",
      "order": 0,
      "blend": "normal",
    },
    {
      "transform": "center",
      "material": "logo",
      "order": 1,
      "blend": "multiply",
    },
  ],
  "background_color": [0.0, 0.0, 0.0],
}
