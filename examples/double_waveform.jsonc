{
  "audio": {
    "sample_rate": 48000,
    "channel_count": 1,
    "stream_buffer_size": 256,
    "sample_count": 8192,
    "dft_bin_count": 2048,
    "bands_history_length": 1024,
    "bands_history_delta": 0.005,
  },
  "transforms": {
    "fullscreen": {
      "anchor": "top left",
      "position": [
        [0.0, "w"],
        [0.0, "h"],
      ],
      "scale": [
        [1.0, "w"],
        [1.0, "h"],
      ],
      "rotation": 0.0,
    },
    "top strip": {
      "anchor": "top",
      "position": [
        [0.5, "w"],
        [0.0, "h"],
      ],
      "scale": [
        [1.0, "w"],
        [0.35, "h"],
      ],
      "rotation": 0.0,
    },
    "bottom strip": {
      "anchor": "top",
      "position": [
        [0.5, "w"],
        [1.0, "h"],
      ],
      "scale": [
        [-1.0, "w"],
        [-0.35, "h"],
      ],
      "rotation": 0.0,
    },
    "center": {
      "anchor": "center",
      "position": [
        [0.5, "w"],
        [0.5, "h"],
      ],
      "scale": [
        [0.4, "h"],
        [0.4, "h"],
      ],
      "rotation": 0.0,
    },
    "left strip": {
      "anchor": "left",
      "position": [
        [0.0, "w"],
        [0.5, "h"],
      ],
      "scale": [
        [0.4, "w"],
        [0.3, "h"],
      ],
      "rotation": 0.0,
    },
    "right strip": {
      "anchor": "left",
      "position": [
        [1.0, "w"],
        [0.5, "h"],
      ],
      "scale": [
        [-0.4, "w"],
        [0.3, "h"],
      ],
      "rotation": 0.0,
    },
    "top": {
      "anchor": "bottom",
      "position": [
        [0.5, "w"],
        [0.5, "h"],
      ],
      "scale": [
        [1.0, "w"],
        [0.5, "h"],
      ],
      "rotation": 0.0,
    },
    "bottom": {
      "anchor": "bottom",
      "position": [
        [0.5, "w"],
        [0.5, "h"],
      ],
      "scale": [
        [1.0, "w"],
        [-0.5, "h"],
      ],
      "rotation": 0.0,
    },
  },
  "images": {
    "logo": "./logo.png",
  },
  "materials": {
    "waveform": {
      "shader": "waveform",
      "parameters": {
        "background": [0.0, 0.0, 0.0, 0.0],
        "foreground": [1.0, 1.0, 1.0, 1.0],
        "line_width": 50.0,
        "gain": 0.95,
      },
    },
    "spectrogram": {
      "shader": "spectrogram",
      "parameters": {
        "background": [0.0, 0.0, 0.0, 0.0],
        "foreground": [1.0, 1.0, 1.0, 1.0],
        "min_frequency": 1,
        "max_frequency": 20000,
        "gain": 1.65,
        "add": 0.0,
        "circular": false,
        "debug": false,
      },
    },
    // "circular spectrogram": {
    //   "shader": "spectrogram",
    //   "parameters": {
    //     "background": [0.0, 0.0, 0.0, 0.0],
    //     "foreground": [1.0, 1.0, 1.0, 1.0],
    //     "min_frequency": 15,
    //     "max_frequency": 200,
    //     "gain": 0.7,
    //     "add": 0.1,
    //     "circular": true,
    //     "debug": false,
    //   },
    // },
    "pattern": {
      "shader": "pattern",
      "parameters": {
        "lightness": 0.8,
        "chroma": 0.1,
        "scale": 1.0,
        "repeats": 5.0,
        "warp_speed": 1.0,
        "scroll_speed": 1.0,
      },
    },
    "logo": {
      "shader": "image",
      "parameters": {
        "image": "logo",
        "multiply": [1.0, 1.0, 1.0, 1.0],
        "add": [0.0, 0.0, 0.0, 0.0],
        "band_weights": [1.0, 0.0, 0.0, 0.0],
        "min_size": 0.5,
      },
    },
  },
  "panels": {
    "transform": "fullscreen",
    "order": 0,
    "blend": "normal",
    "background": [0.0, 0.0, 0.0, 1.0],
    "children": [
      {
        "transform": "top strip",
        "order": 0,
        "blend": "normal",
        "background": [0.0, 0.0, 0.0, 1.0],
        "children": [
          {
            "transform": "fullscreen",
            "material": "pattern",
            "order": 0,
            "blend": "normal",
          },
          {
            "transform": "fullscreen",
            "material": "waveform",
            "order": 1,
            "blend": "multiply",
          },
        ],
      },

      {
        "transform": "bottom strip",
        "order": 0,
        "blend": "normal",
        "background": [0.0, 0.0, 0.0, 1.0],
        "children": [
          {
            "transform": "fullscreen",
            "material": "pattern",
            "order": 0,
            "blend": "normal",
          },
          {
            "transform": "fullscreen",
            "material": "waveform",
            "order": 1,
            "blend": "multiply",
          },
        ],
      },
      {
        "transform": "center",
        "order": 0,
        "blend": "normal",
        "background": [0.0, 0.0, 0.0, 1.0],
        "children": [
          {
            "transform": "fullscreen",
            "material": "pattern",
            "order": 0,
            "blend": "normal",
          },
          {
            "transform": "fullscreen",
            "material": "logo",
            "order": 1,
            "blend": "multiply",
          },
        ],
      },
      {
        "transform": "left strip",
        "order": 0,
        "blend": "normal",
        "background": [0.0, 0.0, 0.0, 1.0],
        "children": [
          {
            "transform": "fullscreen",
            "material": "pattern",
            "order": 0,
            "blend": "normal",
          },
          {
            "transform": "top",
            "material": "spectrogram",
            "order": 1,
            "blend": "multiply",
          },
          {
            "transform": "bottom",
            "material": "spectrogram",
            "order": 1,
            "blend": "multiply",
          },
        ],
      },
      {
        "transform": "right strip",
        "order": 0,
        "blend": "normal",
        "background": [0.0, 0.0, 0.0, 1.0],
        "children": [
          {
            "transform": "fullscreen",
            "material": "pattern",
            "order": 0,
            "blend": "normal",
          },
          {
            "transform": "top",
            "material": "spectrogram",
            "order": 1,
            "blend": "multiply",
          },
          {
            "transform": "bottom",
            "material": "spectrogram",
            "order": 1,
            "blend": "multiply",
          },
        ],
      },
    ],
  },
}
