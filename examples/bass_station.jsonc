{
  "audio": {
    "sample_rate": 48000,
    "channel_count": 1,
    "stream_buffer_size": 256,
    "sample_count": 8192,
    "dft_bin_count": 2048,
    "bands_history_length": 1024,
    "bands_history_delta": 0.005,
  },
  "transforms": {
    "fullscreen": {
      "anchor": "top left",
      "position": [
        [0.0, "w"],
        [0.0, "h"],
      ],
      "scale": [
        [1.0, "w"],
        [1.0, "h"],
      ],
      "rotation": 0.0,
    },
  },
  "images": {
    "logo": "./logo.png",
  },
  "materials": {
    "pattern": {
      "shader": "pattern",
      "parameters": {
        "lightness": 0.8,
        "chroma": 0.1,
        "scale": 1.0,
        "repeats": 2.0,
        "warp_speed": 1.0,
        "scroll_speed": 2.0,
      },
    },
    "pattern_3": {
      "shader": "pattern",
      "parameters": {
        "lightness": 0.8,
        "chroma": 0.1,
        "scale": 3.0,
        "repeats": 2.0,
        "warp_speed": 1.0,
        "scroll_speed": 2.0,
      },
    },
    "waveform": {
      "shader": "waveform",
      "parameters": {
        "background": [0.0, 0.0, 0.0, 0.0],
        "foreground": [1.0, 1.0, 1.0, 1.0],
        "line_width": 50.0,
        "gain": 0.9,
      },
    },
    "spectrogram": {
      "shader": "spectrogram",
      "parameters": {
        "background": [0.0, 0.0, 0.0, 0.0],
        "foreground": [1.0, 1.0, 1.0, 1.0],
        "min_frequency": 20.0,
        "max_frequency": 20000.0,
        "gain": 1.5,
        "add": 0.0,
        "circular": false,
        "debug": false,
      },
    },
    "logo_07": {
      "shader": "image",
      "parameters": {
        "image": "logo",
        "multiply": [1.0, 1.0, 1.0, 1.0],
        "add": [0.0, 0.0, 0.0, 0.0],
        "band_weights": [1.0, 0.0, 0.0, 0.0],
        "min_size": 0.7,
      },
    },
  },
  "panels": {
    "transform": "fullscreen",
    "order": 0,
    "blend": "normal",
    "background_color": [0.0, 0.0, 0.0, 1.0],
    "children": [
      {
        // Waveform, masked by the rainbow pattern.
        "transform": {
          "anchor": "center",
          "position": [
            [596.0, "px"],
            [744.5, "px"],
          ],
          "scale": [
            [1192.0, "px"],
            [671.0, "px"],
          ],
          "rotation": 0.0,
        },
        "order": 0,
        "blend": "normal",
        "background_color": [0.0, 0.0, 0.0, 0.0],
        "children": [
          {
            "transform": "fullscreen",
            "material": "pattern",
            "order": 0,
            "blend": "normal",
          },
          {
            "transform": "fullscreen",
            "material": "waveform",
            "order": 1,
            "blend": "multiply",
          },
        ],
      },
      {
        // Right vertical pattern.
        "transform": {
          "anchor": "center",
          "position": [
            [1619.0, "px"],
            [540.0, "px"],
          ],
          "scale": [
            [602.0, "px"],
            [1080.0, "px"],
          ],
          "rotation": 0.0,
        },
        "material": "pattern_3",
        "order": 0,
        "blend": "normal",
      },
      {
        // Top right spectrogram.
        "transform": {
          "anchor": "center",
          "position": [
            [1738.0, "px"],
            [310.0, "px"],
          ],
          "scale": [
            [-215.0, "px"],
            [215.0, "px"],
          ],
          "rotation": 45.0,
        },
        "material": "spectrogram",
        "order": 0,
        "blend": "normal",
      },
      {
        // Bottom right spectrogram.
        "transform": {
          "anchor": "center",
          "position": [
            [1738.0, "px"],
            [780.0, "px"],
          ],
          "scale": [
            [215.0, "px"],
            [215.0, "px"],
          ],
          "rotation": 135.0,
        },
        "material": "spectrogram",
        "order": 0,
        "blend": "normal",
      },
      {
        // Logo.
        "transform": {
          "anchor": "center",
          "position": [
            [1645.0, "px"],
            [545.0, "px"],
          ],
          "scale": [
            [160.0, "px"],
            [160.0, "px"],
          ],
          "rotation": -90.0,
        },
        "material": "logo_07",
        "order": 0,
        "blend": "normal",
      },
    ],
  },
  "background_color": [0.0, 0.0, 0.0, 1.0],
}
